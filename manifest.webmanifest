{
  "name": "Photocairn",
  "short_name": "Photocairn",
  "description": "Free, private photo editor. No ads, no account, nothing uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#16171a",
  "theme_color": "#16171a",
  "icons": [
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "image/*": [".jpg", ".jpeg", ".png", ".webp", ".gif", ".avif", ".bmp"] } }
  ]
}
